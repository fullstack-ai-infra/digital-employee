{
  "name": "@fullstack-ai-infra/digital-employee",
  "version": "0.3.0",
  "description": "An Agent-native CLI and outer runtime for portable digital employees.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fullstack-ai-infra/digital-employee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstack-ai-infra/digital-employee.git"
  },
  "bugs": {
    "url": "https://github.com/fullstack-ai-infra/digital-employee/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "digital-employee": "./dist/apps/cli/bin.js"
  },
  "types": "./dist/packages/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/core/index.d.ts",
      "import": "./dist/packages/core/index.js"
    },
    "./core": {
      "types": "./dist/packages/core/index.d.ts",
      "import": "./dist/packages/core/index.js"
    },
    "./host-runtime": {
      "types": "./dist/apps/cli/host-runtime.d.ts",
      "import": "./dist/apps/cli/host-runtime.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ./scripts/clean-build-output.js && tsc --project tsconfig.build.json && node ./scripts/copy-build-assets.js",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.test.json",
    "ask": "npm run build --silent && node ./dist/apps/cli/bin.js ask",
    "demo": "npm run build --silent && node ./dist/apps/cli/bin.js ask --config ./dist/configs/demo.json",
    "serve": "npm run build --silent && node ./dist/apps/cli/bin.js serve",
    "start": "npm run build --silent && node ./dist/apps/cli/bin.js --help",
    "sync": "npm run build --silent && node ./dist/apps/cli/bin.js sync",
    "legacy:ask": "npm run build --silent && node ./dist/apps/cli/bin.js legacy ask",
    "legacy:demo": "npm run build --silent && node ./dist/apps/cli/bin.js legacy ask --config ./dist/configs/demo.json",
    "legacy:serve": "npm run build --silent && node ./dist/apps/cli/bin.js legacy serve",
    "legacy:start": "npm run build --silent && node ./dist/apps/cli/bin.js legacy start",
    "legacy:sync": "npm run build --silent && node ./dist/apps/cli/bin.js legacy sync",
    "deploy": "npm run build --silent && node ./dist/apps/cli/bin.js deploy",
    "employee:init": "npm run build --silent && node ./dist/apps/cli/bin.js init",
    "employee:validate": "npm run build --silent && node ./dist/apps/cli/bin.js validate",
    "employee:run": "npm run build --silent && node ./dist/apps/cli/bin.js run",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration:signed-task-e2e": "tsx --test tests/integration/signed-task-e2e.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-concurrency=1 --test-coverage-include='apps/**/*.ts' --test-coverage-include='connectors/**/*.ts' --test-coverage-include='packages/**/*.ts' --test-coverage-include='profiles/**/*.ts' --test-coverage-include='scripts/**/*.js' --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=80 tests/**/*.test.ts",
    "security:check": "node ./scripts/security-check.js",
    "release:check": "node ./scripts/release-check.js",
    "distribution:prepare": "npm run build && node ./scripts/prepare-distribution.js",
    "distribution:smoke": "node ./scripts/distribution-smoke.js",
    "prepack": "npm run distribution:prepare",
    "prepublishOnly": "npm run check && npm run release:check",
    "check": "npm run typecheck && npm run build && npm test && npm run security:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "dingtalk-stream": "2.1.5"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
